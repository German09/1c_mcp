<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument enabled="true" />
        <staticContent>
            <remove fileExtension=".reg" />
            <mimeMap fileExtension=".reg" mimeType="application/octet-stream" />
        </staticContent>
    </system.webServer>
</configuration>
