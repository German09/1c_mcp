// Менеджер MCP-инструмента выполнения произвольного кода 1С.

#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет описания MCP-инструментов выполнения кода.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица описаний инструментов MCP.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	МассивПараметров = Новый Массив; // Массив из Структура
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code",
		"string",
		"Код 1С для выполнения (блок операторов через Выполнить). Для возврата значения присвойте его переменной Результат. Нельзя объявлять Процедура/Функция и использовать Возврат.",
		,
		Истина));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"execution_context",
		"string",
		"Контекст выполнения: server (по умолчанию) - в HTTP-сеансе MCP; client - в клиенте 1С пользователя через клиентский агент (расширение Ei), только синхронный код.",
		"server",
		Ложь,
		"server,client"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"request_id",
		"string",
		"Идентификатор запроса из ответа status=pending_approval. Передайте его вместе с тем же code и execution_context, чтобы дождаться решения пользователя по уже созданному запросу.",
		,
		Ложь));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	ОпасныеРазрешены = ОпасныеОперацииРазрешены();
	Если ОпасныеРазрешены Тогда
		ОписаниеРежима = "Режим базы: копия, разработка или эталон (в БСП включена блокировка работы с внешними ресурсами). Черный список опасных конструкций для server НЕ применяется - разрешены запись, удаление, файлы, COM и т.п.; в ответе dangerous_operations_allowed=true.";
	Иначе
		ОписаниеРежима = "Режим базы: рабочая. Опасные конструкции выполняются только после подтверждения человеком в клиенте 1С, если установлен клиентский агент, иначе блокируются; в ответе dangerous_operations_allowed=false.";
	КонецЕсли;
	ОписаниеРежима = ОписаниеРежима + " " + ОписаниеОпасныхКонструкций(ОпасныеРазрешены);
	Если Не ОпасныеРазрешены Тогда
		ОписаниеРежима = ОписаниеРежима + " " + ОписаниеВызововКонфигурации();
	КонецЕсли;
	
	СостояниеАгента = mcp_КлиентскийАгент.СостояниеАгента();
	Если СостояниеАгента.Доступен Тогда
		ОписаниеАгента = "Клиентский агент (расширение Ei) установлен: опасный server-код и client-код с опасными конструкциями показываются пользователю на подтверждение, безопасный client-код выполняется сразу. Если пользователь не ответил за 40 с, возвращается status=pending_approval и request_id - повторите вызов с тем же code и request_id.";
	Иначе
		ОписаниеАгента = "Клиентский агент недоступен (" + СостояниеАгента.Причина + "): execution_context=client и подтверждение опасного кода не работают.";
	КонецЕсли;
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_code",
		"Выполняет произвольный код на языке 1С на сервере или в клиенте 1С (блок операторов через Выполнить). Ограничения: нельзя объявлять Процедура/Функция и нельзя использовать Возврат - результат присваивайте переменной Результат. "
			+ ОписаниеРежима + " " + ОписаниеАгента,
		СхемаПараметров);
	
КонецПроцедуры

// Выполняет инструмент по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента.
//  Аргументы - Структура - параметры вызова.
//
// Возвращаемое значение:
//  Строка - JSON-строка с результатом.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента <> "execute_code" Тогда
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
	Код = "";
	ЗначениеКода = Неопределено;
	Если Аргументы.Свойство("code", ЗначениеКода) И ЗначениеКода <> Неопределено Тогда
		Код = Строка(ЗначениеКода);
	КонецЕсли;
	
	Контекст = "server";
	ЗначениеКонтекста = Неопределено;
	Если Аргументы.Свойство("execution_context", ЗначениеКонтекста)
		И ЗначениеЗаполнено(ЗначениеКонтекста) Тогда
		Контекст = НРег(Строка(ЗначениеКонтекста));
	КонецЕсли;
	
	ИдентификаторЗапроса = "";
	ЗначениеИдентификатора = Неопределено;
	Если Аргументы.Свойство("request_id", ЗначениеИдентификатора)
		И ЗначениеЗаполнено(ЗначениеИдентификатора) Тогда
		ИдентификаторЗапроса = СокрЛП(Строка(ЗначениеИдентификатора));
	КонецЕсли;
	
	Результат = ВыполнитьКод(Код, Контекст, ИдентификаторЗапроса);
	Возврат Результат;
	
КонецФункции

// Ищет в коде конструкции, ради которых клиентский агент должен спросить человека.
// Агент вызывает функцию по имени, без ссылки на MCP в коде, см. docs/client-agent-protocol.md
//
// Параметры:
//  Код - Строка - фрагмент BSL
//  Контекст - Строка - server или client
//
// Возвращаемое значение:
//  Массив из Строка - опасные и запрещенные в рабочей базе конструкции
//
Функция НайтиОпасныеКонструкции(Код, Контекст) Экспорт
	
	Найденные = НайтиОпасныеКлючевыеСлова(Код, Контекст);
	Для Каждого Слово Из НайтиЗапрещенныеКлючевыеСлова(Код) Цикл
		ДобавитьУникальное(Найденные, Слово);
	КонецЦикла;
	
	Возврат Найденные;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет код на сервере или в клиенте с проверкой опасных конструкций.
// Опасный серверный код в рабочей базе и клиентский код идут через клиентский агент, см. mcp_КлиентскийАгент
//
// Параметры:
//  Код - Строка - фрагмент BSL.
//  Контекст - Строка - server или client.
//  ИдентификаторЗапроса - Строка - request_id ранее созданного запроса к агенту.
//
// Возвращаемое значение:
//  Строка - JSON-ответ {success, data|error, ...}.
//
Функция ВыполнитьКод(Код, Контекст, ИдентификаторЗапроса)
	
	РезультатОтвета = Новый Структура;
	РезультатОтвета.Вставить("success", Ложь);
	
	Если Не ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		РезультатОтвета.Вставить("error", "Параметр code обязателен и не может быть пустым");
	ИначеЕсли Контекст <> "server" И Контекст <> "client" Тогда
		РезультатОтвета.Вставить("error", "Недопустимый execution_context: " + Контекст + ". Допустимо: server, client");
	Иначе
		
		ОпасныеРазрешены = ОпасныеОперацииРазрешены();
		РезультатОтвета.Вставить("dangerous_operations_allowed", ОпасныеРазрешены);
		РезультатОтвета.Вставить("execution_context", Контекст);
		
		Запрещенные = Новый Массив; // Массив из Строка
		Если Не ОпасныеРазрешены Тогда
			Запрещенные = НайтиЗапрещенныеКлючевыеСлова(Код);
		КонецЕсли;
		
		// Клиентский код выполняется на компьютере пользователя: его проверяем и в копии базы.
		НайденныеОпасные = Новый Массив; // Массив из Строка
		Если Контекст = "client" Или Не ОпасныеРазрешены Тогда
			НайденныеОпасные = НайтиОпасныеКлючевыеСлова(Код, Контекст);
		КонецЕсли;
		
		Если Запрещенные.Количество() > 0 Тогда
			РезультатОтвета.Вставить("error",
				"Операция запрещена в рабочей базе даже с подтверждением: код обращается к хранилищам настроек, уведомлениям клиента или клиентскому агенту: "
					+ СтрСоединить(Запрещенные, ", "));
			РезультатОтвета.Вставить("dangerous_keywords", Запрещенные);
		ИначеЕсли Контекст = "server" И НайденныеОпасные.Количество() = 0 Тогда
			ВыполнитьНаСервере(Код, РезультатОтвета);
		Иначе
			ВыполнитьЧерезАгента(Код, Контекст, НайденныеОпасные, ИдентификаторЗапроса, РезультатОтвета);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(РезультатОтвета);
	
КонецФункции

Процедура ВыполнитьНаСервере(Код, РезультатОтвета)
	
	Попытка
		Результат = Неопределено; // фрагмент кода присваивает значение этой переменной
		//@skip-check server-execution-safe-mode
		Выполнить(Код);
		РезультатОтвета.Вставить("success", Истина);
		РезультатОтвета.Вставить("data", Результат);
	Исключение
		РезультатОтвета.Вставить("error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Запрашивает у человека подтверждение серверного кода или выполнение клиентского
// и заполняет ответ по решению агента.
//
// Параметры:
//  Код - Строка
//  Контекст - Строка - server или client
//  НайденныеОпасные - Массив из Строка
//  ИдентификаторЗапроса - Строка
//  РезультатОтвета - Структура - дополняется полями ответа MCP
//
Процедура ВыполнитьЧерезАгента(Код, Контекст, НайденныеОпасные, ИдентификаторЗапроса, РезультатОтвета)
	
	Если НайденныеОпасные.Количество() > 0 Тогда
		РезультатОтвета.Вставить("dangerous_keywords", НайденныеОпасные);
	КонецЕсли;
	
	СостояниеАгента = mcp_КлиентскийАгент.СостояниеАгента();
	Если Не СостояниеАгента.Доступен Тогда
		Если Контекст = "client" Тогда
			РезультатОтвета.Вставить("error",
				"execution_context=client недоступен: " + СостояниеАгента.Причина + ". Используйте execution_context=server.");
		Иначе
			РезультатОтвета.Вставить("error",
				"Операция запрещена: код содержит опасные конструкции: " + СтрСоединить(НайденныеОпасные, ", ")
					+ ". Подтверждение человеком недоступно: " + СостояниеАгента.Причина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Попытка
		Решение = mcp_КлиентскийАгент.ЗапроситьРешение(Код, Контекст, НайденныеОпасные, ИдентификаторЗапроса);
	Исключение
		РезультатОтвета.Вставить("error", "Ошибка обмена с клиентским агентом: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Решение.Статус = "error" Тогда
		РезультатОтвета.Вставить("error", Решение.Ошибка);
	ИначеЕсли Решение.Статус = "pending" Тогда
		РезультатОтвета.Вставить("status", "pending_approval");
		РезультатОтвета.Вставить("request_id", Решение.Идентификатор);
		РезультатОтвета.Вставить("message",
			"Ожидается решение пользователя в клиенте 1С. Повторите execute_code с тем же code и execution_context и request_id="
				+ Решение.Идентификатор + ", чтобы дождаться ответа.");
	Иначе
		Ответ = Решение.Ответ;
		РезультатОтвета.Вставить("request_id", Решение.Идентификатор);
		РезультатОтвета.Вставить("user_decision", Ответ.Решение);
		Если Ответ.Решение = "Отклонено" Тогда
			РезультатОтвета.Вставить("error", "Пользователь отклонил выполнение кода");
		ИначеЕсли Ответ.Решение = "Разрешено" Тогда
			ВыполнитьНаСервере(Код, РезультатОтвета);
		Иначе
			ЗаполнитьРезультатКлиента(Ответ, РезультатОтвета);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатКлиента(Ответ, РезультатОтвета)
	
	Успех = ТипЗнч(Ответ.Успех) = Тип("Булево") И Ответ.Успех;
	РезультатОтвета.Вставить("success", Успех);
	
	Если Успех Тогда
		РезультатОтвета.Вставить("data", ЗначениеИзJSON(Ответ.РезультатJSON));
		РезультатОтвета.Вставить("result_type", Ответ.ТипРезультата);
	Иначе
		РезультатОтвета.Вставить("error", Ответ.Ошибка);
	КонецЕсли;
	
	Если ТипЗнч(Ответ.КодИзменен) = Тип("Булево") И Ответ.КодИзменен Тогда
		РезультатОтвета.Вставить("code_modified", Истина);
		РезультатОтвета.Вставить("executed_code", Ответ.Код);
	КонецЕсли;
	
КонецПроцедуры

// Возвращаемое значение:
//  Произвольный - прочитанное значение или исходная строка, если это не JSON
//
Функция ЗначениеИзJSON(СтрокаJSON)
	
	Значение = СтрокаJSON;
	Если ТипЗнч(СтрокаJSON) = Тип("Строка") И ЗначениеЗаполнено(СтрокаJSON) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Попытка
			Значение = ПрочитатьJSON(ЧтениеJSON, Истина);
		Исключение
			Значение = СтрокаJSON;
		КонецПопытки;
		ЧтениеJSON.Закрыть();
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Определяет, можно ли выполнять опасные операции (запись, удаление и т.п.) без черного списка.
// Разрешено, если база на БСП и в ней включена блокировка работы с внешними ресурсами:
// БСП устанавливает ее при явном запрете администратора и при распознавании базы как копии.
// В такой базе безопасно менять данные - это нужно, например, для подготовки эталонной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если блокировка работы с внешними ресурсами включена.
//
Функция ОпасныеОперацииРазрешены()
	
	Разрешены = Ложь;
	
	Если Метаданные.ОбщиеМодули.Найти("БлокировкаРаботыСВнешнимиРесурсами") <> Неопределено Тогда
		Попытка
			МодульБлокировки = ОбщегоНазначения.ОбщийМодуль("БлокировкаРаботыСВнешнимиРесурсами");
			Разрешены = МодульБлокировки.РаботаСВнешнимиРесурсамиЗаблокирована() = Истина;
		Исключение
			// Версия БСП без нужного API или недоступен параметр сеанса - остаемся в безопасном режиме.
			Разрешены = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Разрешены;
	
КонецФункции

// Ищет опасные ключевые слова в коде.
//
// Параметры:
//  Код - Строка
//  Контекст - Строка - server или client: для клиента список шире
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция НайтиОпасныеКлючевыеСлова(Код, Контекст)
	
	Найденные = Новый Массив; // Массив из Строка
	КодВРег = ВРег(Код);
	
	Слова = ОпасныеКлючевыеСловаПоУмолчанию();
	Если Контекст = "client" Тогда
		Для Каждого Слово Из ОпасныеКлючевыеСловаКлиента() Цикл
			Слова.Добавить(Слово);
		КонецЦикла;
	КонецЕсли;
	
	ДобавитьНайденныеСлова(Найденные, КодВРег, Слова, Ложь);
	
	// Вложенный Выполнить/Вычислить обходит blacklist строкой - блокируем,
	// но разрешаем методы вида Запрос.Выполнить().
	ДобавитьНайденныеСлова(Найденные, КодВРег, ОпасныеКлючевыеСловаБезТочки(), Истина);
	
	Возврат Найденные;
	
КонецФункции

// Ищет конструкции, которые в рабочей базе запрещены даже с подтверждением:
// через них модель могла бы подделать запрос или ответ клиентского агента.
//
// Параметры:
//  Код - Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция НайтиЗапрещенныеКлючевыеСлова(Код)
	
	Найденные = Новый Массив; // Массив из Строка
	ДобавитьНайденныеСлова(Найденные, ВРег(Код), ЗапрещенныеКлючевыеСлова(), Ложь);
	
	Возврат Найденные;
	
КонецФункции

Процедура ДобавитьНайденныеСлова(Найденные, КодВРег, Слова, ТолькоБезТочкиСпереди)
	
	Для Каждого Слово Из Слова Цикл
		Если СодержитИдентификатор(КодВРег, ВРег(Слово), ТолькоБезТочкиСпереди) Тогда
			ДобавитьУникальное(Найденные, Слово);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУникальное(Массив, Значение)
	
	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

// Ищет целое слово/идентификатор, чтобы ЗаписатьJSON не считался Записать.
// ТолькоБезТочкиСпереди=Истина - игнорировать вызовы вида Объект.Метод().
//
// Параметры:
//  ТекстВРег - Строка
//  ИдентификаторВРег - Строка
//  ТолькоБезТочкиСпереди - Булево
//
// Возвращаемое значение:
//  Булево
//
Функция СодержитИдентификатор(ТекстВРег, ИдентификаторВРег, ТолькоБезТочкиСпереди = Ложь)
	
	Найден = Ложь;
	ДлинаИд = СтрДлина(ИдентификаторВРег);
	
	Если ДлинаИд > 0 Тогда
		
		Позиция = 1;
		Пока Не Найден Цикл
			
			Позиция = СтрНайти(ТекстВРег, ИдентификаторВРег, , Позиция);
			Если Позиция = 0 Тогда
				Прервать;
			КонецЕсли;
			
			СимволДо = "";
			Если Позиция > 1 Тогда
				СимволДо = Сред(ТекстВРег, Позиция - 1, 1);
			КонецЕсли;
			
			СимволПосле = Сред(ТекстВРег, Позиция + ДлинаИд, 1);
			
			ЭтоЦелыйИдентификатор = Не ЭтоСимволИдентификатора(СимволДо)
				И Не ЭтоСимволИдентификатора(СимволПосле);
			
			Если ЭтоЦелыйИдентификатор Тогда
				Если ТолькоБезТочкиСпереди И СимволДо = "." Тогда
					Позиция = Позиция + ДлинаИд;
				Иначе
					Найден = Истина;
				КонецЕсли;
			Иначе
				Позиция = Позиция + ДлинаИд;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Найден;
	
КонецФункции

// Проверяет, является ли символ частью идентификатора BSL.
//
// Параметры:
//  Символ - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСимволИдентификатора(Символ)
	
	ЭтоИдентификатор = Ложь;
	
	Если ЗначениеЗаполнено(Символ) Тогда
		КодСимвола = КодСимвола(Символ);
		// 0-9, A-Z, _, кириллица
		Если (КодСимвола >= 48 И КодСимвола <= 57)
			Или (КодСимвола >= 65 И КодСимвола <= 90)
			Или КодСимвола = 95
			Или (КодСимвола >= 1040 И КодСимвола <= 1103)
			Или КодСимвола = 1025 Или КодСимвола = 1105 Тогда
			ЭтоИдентификатор = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоИдентификатор;
	
КонецФункции

