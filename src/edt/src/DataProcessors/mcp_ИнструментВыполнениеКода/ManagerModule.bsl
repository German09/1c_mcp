// Описание опасных конструкций для MCP-описания инструмента - из тех же списков, что и проверка кода.
//
// Параметры:
//  ОпасныеРазрешены - Булево - база-копия: черный список действует только для client
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОпасныхКонструкций(ОпасныеРазрешены)
	
	Если ОпасныеРазрешены Тогда
		Описание = "Для client опасными считаются (и их английские аналоги): ";
	Иначе
		Описание = "Опасными считаются (и их английские аналоги): ";
	КонецЕсли;
	
	Описание = Описание + ПредставлениеКлючевыхСлов(ОпасныеКлючевыеСловаПоУмолчанию())
		+ "; " + ПредставлениеКлючевыхСлов(ОпасныеКлючевыеСловаБезТочки())
		+ " без точки перед именем (Запрос.Выполнить() можно); а также в client: "
		+ ПредставлениеКлючевыхСлов(ОпасныеКлючевыеСловаКлиента()) + ".";
	
	Если Не ОпасныеРазрешены Тогда
		Описание = Описание + " Запрещено даже с подтверждением: "
			+ ПредставлениеКлючевыхСлов(ЗапрещенныеКлючевыеСлова()) + ".";
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

// Требование к вызову методов конфигурации: черный список видит только текст кода,
// а не то, что метод делает внутри.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеВызововКонфигурации()
	
	Возврат "Вызовы методов конфигурации (общих модулей, модулей менеджеров и объектов) проверка видит только по имени: что метод делает внутри, в том числе через несколько уровней вложенных вызовов, ей неизвестно. "
		+ "Отсутствие отказа и запроса подтверждения не означает, что код только читает данные. "
		+ "Вызывайте метод конфигурации, только если вам доступен исходный код этой конфигурации (MCP-сервер с исходниками или файлы выгрузки) и вы прошли всю цепочку вызовов: в ней нет записи, удаления, проведения и пометки удаления данных, работы с файлами, внешними ресурсами и фоновыми заданиями. "
		+ "Если исходников нет, цепочку не удалось пройти до конца или в ней есть вызовы по имени-строке (Выполнить, Вычислить, вызов метода или общего модуля по имени, ОписаниеОповещения), считайте, что метод изменяет данные, и не вызывайте его без явного согласия пользователя. "
		+ "Для чтения данных используйте execute_query.";
	
КонецФункции

// Списки ключевых слов содержат русские имена и их английские аналоги - в описание идут только русские.
//
// Параметры:
//  Слова - Массив из Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеКлючевыхСлов(Слова)
	
	РусскиеСлова = Новый Массив; // Массив из Строка
	Для Каждого Слово Из Слова Цикл
		Если ЕстьКириллица(Слово) Тогда
			РусскиеСлова.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(РусскиеСлова, ", ");
	
КонецФункции

// Параметры:
//  Строка - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьКириллица(Строка)
	
	Найдена = Ложь;
	Для Номер = 1 По СтрДлина(Строка) Цикл
		КодСимвола = КодСимвола(Строка, Номер);
		Если (КодСимвола >= 1040 И КодСимвола <= 1103) Или КодСимвола = 1025 Или КодСимвола = 1105 Тогда
			Найдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Найдена;
	
КонецФункции

