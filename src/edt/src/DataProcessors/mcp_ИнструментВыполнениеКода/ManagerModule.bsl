// Менеджер MCP-инструмента выполнения произвольного кода 1С.

#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет описания MCP-инструментов выполнения кода.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица описаний инструментов MCP.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	МассивПараметров = Новый Массив; // Массив из Структура
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code",
		"string",
		"Код 1С для выполнения (блок операторов через Выполнить). Для возврата значения присвойте его переменной Результат. Нельзя объявлять Процедура/Функция и использовать Возврат.",
		,
		Истина));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"execution_context",
		"string",
		"Контекст выполнения: только server (по умолчанию). Клиентский контекст недоступен в HTTP MCP-сервере.",
		"server",
		Ложь,
		"server,client"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	Если ОпасныеОперацииРазрешены() Тогда
		ОписаниеРежима = "Режим базы: копия, разработка или эталон (в БСП включена блокировка работы с внешними ресурсами). Черный список опасных конструкций НЕ применяется - разрешены запись, удаление, файлы, COM и т.п.; в ответе dangerous_operations_allowed=true.";
	Иначе
		ОписаниеРежима = "Режим базы: рабочая. Опасные конструкции (Удалить/Записать/COM/файлы и др.) блокируются черным списком; в ответе dangerous_operations_allowed=false.";
	КонецЕсли;
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_code",
		"Выполняет произвольный код на языке 1С на сервере (блок операторов через Выполнить). Ограничения: нельзя объявлять Процедура/Функция и нельзя использовать Возврат - результат присваивайте переменной Результат. "
			+ ОписаниеРежима,
		СхемаПараметров);
	
КонецПроцедуры

// Выполняет инструмент по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента.
//  Аргументы - Структура - параметры вызова.
//
// Возвращаемое значение:
//  Строка - JSON-строка с результатом.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента <> "execute_code" Тогда
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
	Код = "";
	ЗначениеКода = Неопределено;
	Если Аргументы.Свойство("code", ЗначениеКода) И ЗначениеКода <> Неопределено Тогда
		Код = Строка(ЗначениеКода);
	КонецЕсли;
	
	Контекст = "server";
	ЗначениеКонтекста = Неопределено;
	Если Аргументы.Свойство("execution_context", ЗначениеКонтекста)
		И ЗначениеЗаполнено(ЗначениеКонтекста) Тогда
		Контекст = НРег(Строка(ЗначениеКонтекста));
	КонецЕсли;
	
	Результат = ВыполнитьКод(Код, Контекст);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет код на сервере с проверкой опасных конструкций.
//
// Параметры:
//  Код - Строка - фрагмент BSL.
//  Контекст - Строка - ожидается "server".
//
// Возвращаемое значение:
//  Строка - JSON-ответ {success, data|error, ...}.
//
Функция ВыполнитьКод(Код, Контекст)
	
	РезультатОтвета = Новый Структура;
	РезультатОтвета.Вставить("success", Ложь);
	
	Если Не ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		РезультатОтвета.Вставить("error", "Параметр code обязателен и не может быть пустым");
	ИначеЕсли Контекст = "client" Тогда
		РезультатОтвета.Вставить("error",
			"execution_context=client недоступен: MCP работает через HTTP-сервис на сервере 1С. Используйте execution_context=server.");
	ИначеЕсли Контекст <> "server" Тогда
		РезультатОтвета.Вставить("error", "Недопустимый execution_context: " + Контекст + ". Допустимо: server");
	Иначе
		
		ОпасныеРазрешены = ОпасныеОперацииРазрешены();
		РезультатОтвета.Вставить("dangerous_operations_allowed", ОпасныеРазрешены);
		
		НайденныеОпасные = Новый Массив; // Массив из Строка
		Если Не ОпасныеРазрешены Тогда
			НайденныеОпасные = НайтиОпасныеКлючевыеСлова(Код);
		КонецЕсли;
		
		Если НайденныеОпасные.Количество() > 0 Тогда
			РезультатОтвета.Вставить("error",
				"Операция запрещена: код содержит опасные конструкции: " + СтрСоединить(НайденныеОпасные, ", "));
			РезультатОтвета.Вставить("dangerous_keywords", НайденныеОпасные);
		Иначе
			
			Попытка
				Результат = Неопределено; // фрагмент кода присваивает значение этой переменной
				//@skip-check server-execution-safe-mode
				Выполнить(Код);
				РезультатОтвета.Вставить("success", Истина);
				РезультатОтвета.Вставить("data", Результат);
			Исключение
				РезультатОтвета.Вставить("error",
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(РезультатОтвета);
	
КонецФункции

// Определяет, можно ли выполнять опасные операции (запись, удаление и т.п.) без черного списка.
// Разрешено, если база на БСП и в ней включена блокировка работы с внешними ресурсами:
// БСП устанавливает ее при явном запрете администратора и при распознавании базы как копии.
// В такой базе безопасно менять данные - это нужно, например, для подготовки эталонной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если блокировка работы с внешними ресурсами включена.
//
Функция ОпасныеОперацииРазрешены()
	
	Разрешены = Ложь;
	
	Если Метаданные.ОбщиеМодули.Найти("БлокировкаРаботыСВнешнимиРесурсами") <> Неопределено Тогда
		Попытка
			МодульБлокировки = ОбщегоНазначения.ОбщийМодуль("БлокировкаРаботыСВнешнимиРесурсами");
			Разрешены = МодульБлокировки.РаботаСВнешнимиРесурсамиЗаблокирована() = Истина;
		Исключение
			// Версия БСП без нужного API или недоступен параметр сеанса - остаемся в безопасном режиме.
			Разрешены = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Разрешены;
	
КонецФункции

// Ищет опасные ключевые слова в коде.
//
// Параметры:
//  Код - Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция НайтиОпасныеКлючевыеСлова(Код)
	
	Найденные = Новый Массив; // Массив из Строка
	КодВРег = ВРег(Код);
	
	Для Каждого Слово Из ОпасныеКлючевыеСловаПоУмолчанию() Цикл
		Если СодержитИдентификатор(КодВРег, ВРег(Слово), Ложь) Тогда
			ДобавитьУникальное(Найденные, Слово);
		КонецЕсли;
	КонецЦикла;
	
	// Вложенный Выполнить/Вычислить обходит blacklist строкой - блокируем,
	// но разрешаем методы вида Запрос.Выполнить().
	Для Каждого Слово Из ОпасныеКлючевыеСловаБезТочки() Цикл
		Если СодержитИдентификатор(КодВРег, ВРег(Слово), Истина) Тогда
			ДобавитьУникальное(Найденные, Слово);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Найденные;
	
КонецФункции

Процедура ДобавитьУникальное(Массив, Значение)
	
	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

// Ищет целое слово/идентификатор, чтобы ЗаписатьJSON не считался Записать.
// ТолькоБезТочкиСпереди=Истина - игнорировать вызовы вида Объект.Метод().
//
// Параметры:
//  ТекстВРег - Строка
//  ИдентификаторВРег - Строка
//  ТолькоБезТочкиСпереди - Булево
//
// Возвращаемое значение:
//  Булево
//
Функция СодержитИдентификатор(ТекстВРег, ИдентификаторВРег, ТолькоБезТочкиСпереди = Ложь)
	
	Найден = Ложь;
	ДлинаИд = СтрДлина(ИдентификаторВРег);
	
	Если ДлинаИд > 0 Тогда
		
		Позиция = 1;
		Пока Не Найден Цикл
			
			Позиция = СтрНайти(ТекстВРег, ИдентификаторВРег, , Позиция);
			Если Позиция = 0 Тогда
				Прервать;
			КонецЕсли;
			
			СимволДо = "";
			Если Позиция > 1 Тогда
				СимволДо = Сред(ТекстВРег, Позиция - 1, 1);
			КонецЕсли;
			
			СимволПосле = Сред(ТекстВРег, Позиция + ДлинаИд, 1);
			
			ЭтоЦелыйИдентификатор = Не ЭтоСимволИдентификатора(СимволДо)
				И Не ЭтоСимволИдентификатора(СимволПосле);
			
			Если ЭтоЦелыйИдентификатор Тогда
				Если ТолькоБезТочкиСпереди И СимволДо = "." Тогда
					Позиция = Позиция + ДлинаИд;
				Иначе
					Найден = Истина;
				КонецЕсли;
			Иначе
				Позиция = Позиция + ДлинаИд;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Найден;
	
КонецФункции

// Проверяет, является ли символ частью идентификатора BSL.
//
// Параметры:
//  Символ - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСимволИдентификатора(Символ)
	
	ЭтоИдентификатор = Ложь;
	
	Если ЗначениеЗаполнено(Символ) Тогда
		КодСимвола = КодСимвола(Символ);
		// 0-9, A-Z, _, кириллица
		Если (КодСимвола >= 48 И КодСимвола <= 57)
			Или (КодСимвола >= 65 И КодСимвола <= 90)
			Или КодСимвола = 95
			Или (КодСимвола >= 1040 И КодСимвола <= 1103)
			Или КодСимвола = 1025 Или КодСимвола = 1105 Тогда
			ЭтоИдентификатор = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоИдентификатор;
	
КонецФункции

// Возвращаемое значение:
//  Массив из Строка
//
Функция ОпасныеКлючевыеСловаПоУмолчанию()
	
	Результат = Новый Массив; // Массив из Строка
	Результат.Добавить("Удалить");
	Результат.Добавить("Delete");
	Результат.Добавить("Записать");
	Результат.Добавить("Write");
	Результат.Добавить("УстановитьПривилегированныйРежим");
	Результат.Добавить("SetPrivilegedMode");
	Результат.Добавить("ПодключитьВнешнююКомпоненту");
	Результат.Добавить("AttachAddIn");
	Результат.Добавить("УстановитьВнешнююКомпоненту");
	Результат.Добавить("InstallAddIn");
	Результат.Добавить("COMОбъект");
	Результат.Добавить("COMObject");
	Результат.Добавить("УстановитьМонопольныйРежим");
	Результат.Добавить("SetExclusiveMode");
	Результат.Добавить("УдалитьФайлы");
	Результат.Добавить("DeleteFiles");
	Результат.Добавить("КопироватьФайл");
	Результат.Добавить("CopyFile");
	Результат.Добавить("ПереместитьФайл");
	Результат.Добавить("MoveFile");
	Результат.Добавить("СоздатьКаталог");
	Результат.Добавить("CreateDirectory");
	Результат.Добавить("ЗапуститьПриложение");
	Результат.Добавить("RunApp");
	Результат.Добавить("КомандаСистемы");
	// Нельзя из рабочей базы включить блокировку работы с внешними ресурсами
	// (или подменить параметр сеанса), чтобы снять черный список.
	Результат.Добавить("БлокировкаРаботыСВнешнимиРесурсами");
	Результат.Добавить("ЗапретитьРаботуСВнешнимиРесурсами");
	Результат.Добавить("РаботаСВнешнимиРесурсамиЗаблокирована");
	// Динамический вызов по имени, собранному из строк, обходит черный список.
	Результат.Добавить("ВыполнитьМетод");
	Результат.Добавить("ВычислитьВБезопасномРежиме");
	
	Возврат Результат;
	
КонецФункции

// Возвращаемое значение:
//  Массив из Строка
//
Функция ОпасныеКлючевыеСловаБезТочки()
	
	Результат = Новый Массив; // Массив из Строка
	Результат.Добавить("Выполнить");
	Результат.Добавить("Execute");
	Результат.Добавить("Вычислить");
	Результат.Добавить("Eval");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
