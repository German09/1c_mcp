// Преобразует имена приложений MCP в коды платформы.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Массив, Неопределено
//
Функция ПреобразоватьПриложения(Значение)
	
	Результат = Неопределено;
	Строки = НормализоватьМассивСтрок(Значение);
	
	Если Строки <> Неопределено Тогда
		
		Результат = Новый Массив;
		Для Каждого ИмяПриложения Из Строки Цикл
			Ключ = СокрЛП(ИмяПриложения);
			Если Ключ = "ThinClient" Тогда
				Результат.Добавить("1CV8C");
			ИначеЕсли Ключ = "ThickClient" Тогда
				Результат.Добавить("1CV8");
			ИначеЕсли Ключ = "WebClient" Тогда
				Результат.Добавить("WebClient");
			ИначеЕсли Ключ = "BackgroundJob" Тогда
				Результат.Добавить("BackgroundJob");
			ИначеЕсли Ключ = "Designer" Тогда
				Результат.Добавить("Designer");
			ИначеЕсли Ключ = "COMConnection" Тогда
				Результат.Добавить("COMConnection");
			Иначе
				Результат.Добавить(Ключ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует строковый transaction_status в значение платформы.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Произвольный, Неопределено
//
Функция ПреобразоватьСтатусТранзакции(Значение)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Ключ = ВРег(СокрЛП(Строка(Значение)));
		Если Ключ = "COMMITTED" Тогда
			Результат = СтатусТранзакцииЗаписиЖурналаРегистрации.Зафиксирована;
		ИначеЕсли Ключ = "ROLLEDBACK" Тогда
			Результат = СтатусТранзакцииЗаписиЖурналаРегистрации.Отменена;
		ИначеЕсли Ключ = "NOTAPPLICABLE" Тогда
			Результат = СтатусТранзакцииЗаписиЖурналаРегистрации.НетТранзакции;
		ИначеЕсли Ключ = "UNFINISHED" Тогда
			Результат = СтатусТранзакцииЗаписиЖурналаРегистрации.НеЗавершена;
		Иначе
			ВызватьИсключение "Неизвестный transaction_status: " + Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает ссылку для фильтра Данные из object_description / link / data.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Произвольный, Неопределено
//
Функция ПолучитьДанныеФильтра(Аргументы)
	
	Результат = Неопределено;
	ОписаниеОбъекта = Неопределено;
	
	Если Аргументы.Свойство("object_description", ОписаниеОбъекта)
		И ОписаниеОбъекта <> Неопределено Тогда
		Результат = СсылкаИзОписанияОбъекта(ОписаниеОбъекта);
	Иначе
		
		НавСсылка = "";
		ЗначениеСсылки = Неопределено;
		Если Аргументы.Свойство("link", ЗначениеСсылки) И ЗначениеЗаполнено(ЗначениеСсылки) Тогда
			НавСсылка = ЗначениеСсылки;
		ИначеЕсли Аргументы.Свойство("data", ЗначениеСсылки) И ЗначениеЗаполнено(ЗначениеСсылки) Тогда
			НавСсылка = ЗначениеСсылки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НавСсылка) Тогда
			Результат = СсылкаИзНавигационнойСсылки(НавСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает ссылку по описанию объекта из execute_query.
//
// Параметры:
//  ОписаниеОбъекта - Структура
//
// Возвращаемое значение:
//  ЛюбаяСсылка
//
Функция СсылкаИзОписанияОбъекта(ОписаниеОбъекта)
	
	Если ТипЗнч(ОписаниеОбъекта) <> Тип("Структура") Тогда
		ВызватьИсключение "object_description должен быть объектом";
	КонецЕсли;
	Если Не ОписаниеОбъекта.Свойство("ТипОбъекта")
		Или Не ОписаниеОбъекта.Свойство("УникальныйИдентификатор") Тогда
		ВызватьИсключение "object_description должен содержать ТипОбъекта и УникальныйИдентификатор";
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов(ОписаниеОбъекта.ТипОбъекта);
	ПустоеЗначение = ОписаниеТипа.ПривестиЗначение();
	ИмяОбъекта = ПустоеЗначение.Метаданные().Имя;
	ТипСсылки = ТипЗнч(ПустоеЗначение);
	
	МенеджерОбъекта = Неопределено;
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = Справочники[ИмяОбъекта];
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = Документы[ИмяОбъекта];
	ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = БизнесПроцессы[ИмяОбъекта];
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = ПланыВидовХарактеристик[ИмяОбъекта];
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = ПланыСчетов[ИмяОбъекта];
	ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = ПланыВидовРасчета[ИмяОбъекта];
	ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = Задачи[ИмяОбъекта];
	ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
		МенеджерОбъекта = ПланыОбмена[ИмяОбъекта];
	Иначе
		ВызватьИсключение "Неподдерживаемый ТипОбъекта: " + ОписаниеОбъекта.ТипОбъекта;
	КонецЕсли;
	
	Возврат МенеджерОбъекта.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ОписаниеОбъекта.УникальныйИдентификатор));
	
КонецФункции

// Получает ссылку из навигационной ссылки e1cib/data/...
//
// Параметры:
//  НС - Строка
//
// Возвращаемое значение:
//  Произвольный
//
Функция СсылкаИзНавигационнойСсылки(НС)
	
	НС = РаскодироватьСтроку(НС, СпособКодированияСтроки.КодировкаURL);
	ПерваяТочка = СтрНайти(НС, "e1cib/data/");
	Если ПерваяТочка = 0 Или СтрНайти(НС, "?ref=") = 0 Тогда
		ВызватьИсключение "Некорректная навигационная ссылка: " + НС;
	КонецЕсли;
	
	ВтораяТочка = СтрНайти(НС, "?ref=");
	ПредставлениеТипа = Сред(НС, ПерваяТочка + 11, ВтораяТочка - ПерваяТочка - 11);
	ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
	ЗначениеСсылки = СтрЗаменить(
		ШаблонЗначения,
		"00000000000000000000000000000000",
		Сред(НС, ВтораяТочка + 5));
	
	Возврат ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	
КонецФункции

// Преобразует уровень журнала в строку MCP.
//
// Параметры:
//  Уровень - УровеньЖурналаРегистрации
//
// Возвращаемое значение:
//  Строка
//
Функция УровеньВСтроку(Уровень)
	
	Результат = Строка(Уровень);
	Если Уровень = УровеньЖурналаРегистрации.Информация Тогда
		Результат = "Information";
	ИначеЕсли Уровень = УровеньЖурналаРегистрации.Предупреждение Тогда
		Результат = "Warning";
	ИначеЕсли Уровень = УровеньЖурналаРегистрации.Ошибка Тогда
		Результат = "Error";
	ИначеЕсли Уровень = УровеньЖурналаРегистрации.Примечание Тогда
		Результат = "Note";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует код приложения платформы в имя MCP.
//
// Параметры:
//  ИмяПриложения - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ПриложениеВСтроку(ИмяПриложения)
	
	Результат = Строка(ИмяПриложения);
	Если Результат = "1CV8C" Тогда
		Результат = "ThinClient";
	ИначеЕсли Результат = "1CV8" Тогда
		Результат = "ThickClient";
	ИначеЕсли Результат = "WebClient" Тогда
		Результат = "WebClient";
	ИначеЕсли Результат = "BackgroundJob" Тогда
		Результат = "BackgroundJob";
	ИначеЕсли Результат = "Designer" Тогда
		Результат = "Designer";
	ИначеЕсли Результат = "COMConnection" Тогда
		Результат = "COMConnection";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует статус транзакции в строку MCP.
//
// Параметры:
//  Статус - СтатусТранзакцииЗаписиЖурналаРегистрации
//
// Возвращаемое значение:
//  Строка
//
Функция СтатусТранзакцииВСтроку(Статус)
	
	Результат = Строка(Статус);
	Если Статус = СтатусТранзакцииЗаписиЖурналаРегистрации.Зафиксирована Тогда
		Результат = "Committed";
	ИначеЕсли Статус = СтатусТранзакцииЗаписиЖурналаРегистрации.Отменена Тогда
		Результат = "RolledBack";
	ИначеЕсли Статус = СтатусТранзакцииЗаписиЖурналаРегистрации.НетТранзакции Тогда
		Результат = "NotApplicable";
	ИначеЕсли Статус = СтатусТранзакцииЗаписиЖурналаРегистрации.НеЗавершена Тогда
		Результат = "Unfinished";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Представление поля Метаданные записи журнала.
//
// Параметры:
//  ЗначениеМетаданных - Произвольный
//
// Возвращаемое значение:
//  Строка
//
Функция МетаданныеВСтроку(ЗначениеМетаданных)
	
	Результат = Строка(ЗначениеМетаданных);
	
	Если ТипЗнч(ЗначениеМетаданных) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из ЗначениеМетаданных Цикл
			Части.Добавить(Строка(Элемент));
		КонецЦикла;
		Результат = СтрСоединить(Части, ", ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
