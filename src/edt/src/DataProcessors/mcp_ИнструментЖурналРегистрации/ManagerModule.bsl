// Менеджер MCP-инструмента чтения журнала регистрации.

#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет описания MCP-инструментов журнала регистрации.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица описаний инструментов MCP.
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	МассивПараметров = Новый Массив; // Массив из Структура
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"start_date", "string",
		"Дата начала периода (ISO 8601: YYYY-MM-DDTHH:MM:SS). При пагинации используйте last_date из предыдущего ответа"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"end_date", "string",
		"Дата окончания периода (ISO 8601)"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"levels", "string",
		"Уровни важности: Information, Warning, Error, Note",
		Ложь,
		"Information,Warning,Error,Note"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"events", "string",
		"Фильтр по типу события, например _$Data$_.Post"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number",
		"Максимальное количество записей (1-1000)",
		100));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"same_second_offset", "number",
		"Пропустить N записей с той же секундой, что и start_date (курсорная пагинация). Используйте next_same_second_offset из предыдущего ответа",
		0));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"object_description", "object",
		"Описание объекта из execute_query: {_objectRef, УникальныйИдентификатор, ТипОбъекта}"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"link", "string",
		"Навигационная ссылка e1cib/data/..."));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"data", "string",
		"Ссылка на объект данных (навигационная ссылка) - для обратной совместимости"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"metadata_type", "string",
		"Типы объектов метаданных, например Документ.РеализацияТоваровУслуг"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"user", "string",
		"Имена пользователей ИБ"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"session", "number",
		"Номера сеансов"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"application", "string",
		"Типы приложений: ThinClient, WebClient, ThickClient, BackgroundJob, Designer, COMConnection",
		Ложь,
		"ThinClient,WebClient,ThickClient,BackgroundJob,Designer,COMConnection"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"computer", "string",
		"Имя компьютера"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"comment_contains", "string",
		"Подстрока для поиска в комментарии (регистронезависимый)"));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"transaction_status", "string",
		"Статус транзакции",
		,
		Ложь,
		"Committed,RolledBack,NotApplicable,Unfinished"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_event_log",
		"Читает журнал регистрации 1С с фильтрами и курсорной пагинацией (last_date / next_same_second_offset).",
		СхемаПараметров);
	
КонецПроцедуры

// Выполняет инструмент по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента.
//  Аргументы - Структура - параметры вызова.
//
// Возвращаемое значение:
//  Строка - JSON-строка с результатом.
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента <> "get_event_log" Тогда
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
	Возврат ПолучитьЖурналРегистрации(Аргументы);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает журнал регистрации по аргументам MCP-инструмента get_event_log.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента.
//
// Возвращаемое значение:
//  Строка - JSON-ответ.
//
Функция ПолучитьЖурналРегистрации(Аргументы)
	
	РезультатОтвета = Новый Структура;
	РезультатОтвета.Вставить("success", Ложь);
	
	Попытка
		
		Лимит = НормироватьЛимит(Аргументы);
		СмещениеСекунды = НормироватьСмещениеСекунды(Аргументы);
		Период = РазобратьПериод(Аргументы);
		ДатаНачала = Период.ДатаНачала;
		ДатаОкончания = Период.ДатаОкончания;
		
		Если СмещениеСекунды > 0 И ДатаНачала = Неопределено Тогда
			РезультатОтвета.Вставить("error", "same_second_offset требует указания start_date");
		Иначе
			
			Фильтр = ПостроитьФильтрЖурнала(Аргументы, ДатаНачала, ДатаОкончания);
			ПодстрокаКомментария = ПодстрокаКомментарияИзАргументов(Аргументы);
			
			Выборка = ВыгрузитьИОтобратьЗаписи(
				Фильтр, ДатаНачала, Лимит, СмещениеСекунды, ПодстрокаКомментария);
			
			РезультатОтвета.Вставить("success", Истина);
			РезультатОтвета.Вставить("data", Выборка.Записи);
			РезультатОтвета.Вставить("count", Выборка.Записи.Количество());
			РезультатОтвета.Вставить("has_more", Выборка.ЕстьЕще);
			Если Выборка.ПоследняяДата <> Неопределено Тогда
				РезультатОтвета.Вставить("last_date", Выборка.ПоследняяДата);
				РезультатОтвета.Вставить("next_same_second_offset", Выборка.СледующееСмещение);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		РезультатОтвета.Вставить("success", Ложь);
		РезультатОтвета.Вставить("error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(РезультатОтвета);
	
КонецФункции

// Нормирует лимит записей в диапазоне 1-1000.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Число
//
Функция НормироватьЛимит(Аргументы)
	
	Лимит = 100;
	ЗначениеЛимита = Неопределено;
	Если Аргументы.Свойство("limit", ЗначениеЛимита) И ЗначениеЛимита <> Неопределено Тогда
		Лимит = Число(ЗначениеЛимита);
	КонецЕсли;
	
	Если Лимит < 1 Тогда
		Лимит = 1;
	ИначеЕсли Лимит > 1000 Тогда
		Лимит = 1000;
	КонецЕсли;
	
	Возврат Лимит;
	
КонецФункции

// Нормирует смещение записей внутри одной секунды.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Число
//
Функция НормироватьСмещениеСекунды(Аргументы)
	
	СмещениеСекунды = 0;
	ЗначениеСмещения = Неопределено;
	Если Аргументы.Свойство("same_second_offset", ЗначениеСмещения)
		И ЗначениеСмещения <> Неопределено Тогда
		СмещениеСекунды = Число(ЗначениеСмещения);
		Если СмещениеСекунды < 0 Тогда
			СмещениеСекунды = 0;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СмещениеСекунды;
	
КонецФункции

// Разбирает период выборки; при пустых датах берет последние 7 дней.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Структура:
//   * ДатаНачала - Дата, Неопределено - начало периода
//   * ДатаОкончания - Дата, Неопределено - конец периода
//
Функция РазобратьПериод(Аргументы)
	
	ДатаНачала = Неопределено;
	ДатаОкончания = Неопределено;
	
	ЗначениеНачала = Неопределено;
	Если Аргументы.Свойство("start_date", ЗначениеНачала) И ЗначениеЗаполнено(ЗначениеНачала) Тогда
		ДатаНачала = ДатаИзISO(Строка(ЗначениеНачала));
	КонецЕсли;
	
	ЗначениеОкончания = Неопределено;
	Если Аргументы.Свойство("end_date", ЗначениеОкончания) И ЗначениеЗаполнено(ЗначениеОкончания) Тогда
		ДатаОкончания = ДатаИзISO(Строка(ЗначениеОкончания));
	КонецЕсли;
	
	Если ДатаНачала = Неопределено И ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
		ДатаНачала = ДатаОкончания - 7 * 24 * 60 * 60;
	КонецЕсли;
	
	Период = Новый Структура;
	Период.Вставить("ДатаНачала", ДатаНачала);
	Период.Вставить("ДатаОкончания", ДатаОкончания);
	
	Возврат Период;
	
КонецФункции

// Собирает структуру фильтра для ВыгрузитьЖурналРегистрации.
//
// Параметры:
//  Аргументы - Структура
//  ДатаНачала - Дата, Неопределено -
//  ДатаОкончания - Дата, Неопределено -
//
// Возвращаемое значение:
//  Структура
//
Функция ПостроитьФильтрЖурнала(Аргументы, ДатаНачала, ДатаОкончания)
	
	Фильтр = Новый Структура;
	
	Если ДатаНачала <> Неопределено Тогда
		Фильтр.Вставить("ДатаНачала", ДатаНачала);
	КонецЕсли;
	Если ДатаОкончания <> Неопределено Тогда
		Фильтр.Вставить("ДатаОкончания", ДатаОкончания);
	КонецЕсли;
	
	Уровни = ПреобразоватьУровни(ЗначениеАргумента(Аргументы, "levels"));
	Если Уровни <> Неопределено Тогда
		Фильтр.Вставить("Уровень", Уровни);
	КонецЕсли;
	
	События = НормализоватьМассивСтрок(ЗначениеАргумента(Аргументы, "events"));
	Если События <> Неопределено Тогда
		Фильтр.Вставить("Событие", События);
	КонецЕсли;
	
	ОбъектыМетаданныхОтбора = ПреобразоватьМетаданные(ЗначениеАргумента(Аргументы, "metadata_type"));
	Если ОбъектыМетаданныхОтбора <> Неопределено Тогда
		Фильтр.Вставить("Метаданные", ОбъектыМетаданныхОтбора);
	КонецЕсли;
	
	ПользователиФильтр = ПреобразоватьПользователей(ЗначениеАргумента(Аргументы, "user"));
	Если ПользователиФильтр <> Неопределено Тогда
		Фильтр.Вставить("Пользователь", ПользователиФильтр);
	КонецЕсли;
	
	Сеансы = НормализоватьМассивЧисел(ЗначениеАргумента(Аргументы, "session"));
	Если Сеансы <> Неопределено Тогда
		Фильтр.Вставить("Сеанс", Сеансы);
	КонецЕсли;
	
	Приложения = ПреобразоватьПриложения(ЗначениеАргумента(Аргументы, "application"));
	Если Приложения <> Неопределено Тогда
		Фильтр.Вставить("ИмяПриложения", Приложения);
	КонецЕсли;
	
	ЗначениеКомпьютера = Неопределено;
	Если Аргументы.Свойство("computer", ЗначениеКомпьютера) И ЗначениеЗаполнено(ЗначениеКомпьютера) Тогда
		Фильтр.Вставить("Компьютер", Строка(ЗначениеКомпьютера));
	КонецЕсли;
	
	СтатусТранзакции = ПреобразоватьСтатусТранзакции(ЗначениеАргумента(Аргументы, "transaction_status"));
	Если СтатусТранзакции <> Неопределено Тогда
		Фильтр.Вставить("СтатусТранзакции", СтатусТранзакции);
	КонецЕсли;
	
	ДанныеОбъекта = ПолучитьДанныеФильтра(Аргументы);
	Если ДанныеОбъекта <> Неопределено Тогда
		Фильтр.Вставить("Данные", ДанныеОбъекта);
	КонецЕсли;
	
	Возврат Фильтр;
	
КонецФункции

// Извлекает подстроку фильтра комментария.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Строка
//
Функция ПодстрокаКомментарияИзАргументов(Аргументы)
	
	ПодстрокаКомментария = "";
	ЗначениеКомментария = Неопределено;
	Если Аргументы.Свойство("comment_contains", ЗначениеКомментария)
		И ЗначениеЗаполнено(ЗначениеКомментария) Тогда
		ПодстрокаКомментария = НРег(Строка(ЗначениеКомментария));
	КонецЕсли;
	
	Возврат ПодстрокаКомментария;
	
КонецФункции

// Выгружает журнал и отбирает записи с учетом пагинации и фильтра комментария.
//
// Параметры:
//  Фильтр - Структура
//  ДатаНачала - Дата, Неопределено -
//  Лимит - Число
//  СмещениеСекунды - Число
//  ПодстрокаКомментария - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Записи - Массив из Структура - отобранные записи журнала
//   * ЕстьЕще - Булево - есть ли еще записи за пределами лимита
//   * ПоследняяДата - Дата, Неопределено - дата последней записи
//   * СледующееСмещение - Число - курсор next_same_second_offset
//
Функция ВыгрузитьИОтобратьЗаписи(Фильтр, ДатаНачала, Лимит, СмещениеСекунды, ПодстрокаКомментария)
	
	Запас = СмещениеСекунды + 1;
	Если ЗначениеЗаполнено(ПодстрокаКомментария) Тогда
		Запас = Запас + Лимит * 5;
	КонецЕсли;
	
	МаксимумВыгрузки = Лимит + Запас;
	Если МаксимумВыгрузки > 5000 Тогда
		МаксимумВыгрузки = 5000;
	КонецЕсли;
	
	Колонки = "Дата,Уровень,Событие,Комментарий,ИмяПользователя,Метаданные,ПредставлениеДанных,Сеанс,ИмяПриложения,Компьютер,СтатусТранзакции,Данные";
	ТаблицаЖурнала = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Фильтр, Колонки, , МаксимумВыгрузки);
	ТаблицаЖурнала.Сортировать("Дата, Сеанс, Событие, ИмяПользователя, Метаданные, ПредставлениеДанных");
	
	Записи = Новый Массив; // Массив из Структура
	ПропущеноВСекунде = 0;
	ЕстьЕще = Ложь;
	ПоследняяДата = Неопределено;
	
	Для Каждого СтрокаЖурнала Из ТаблицаЖурнала Цикл
		
		Если ЗначениеЗаполнено(ПодстрокаКомментария)
			И СтрНайти(НРег(Строка(СтрокаЖурнала.Комментарий)), ПодстрокаКомментария) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаНачала <> Неопределено
			И ДатаБезМиллисекунд(СтрокаЖурнала.Дата) = ДатаБезМиллисекунд(ДатаНачала) Тогда
			Если ПропущеноВСекунде < СмещениеСекунды Тогда
				ПропущеноВСекунде = ПропущеноВСекунде + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Записи.Количество() >= Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		
		Запись = Новый Структура;
		Запись.Вставить("date", СтрокаЖурнала.Дата);
		Запись.Вставить("level", УровеньВСтроку(СтрокаЖурнала.Уровень));
		Запись.Вставить("event", Строка(СтрокаЖурнала.Событие));
		Запись.Вставить("comment", Строка(СтрокаЖурнала.Комментарий));
		Запись.Вставить("user", Строка(СтрокаЖурнала.ИмяПользователя));
		Запись.Вставить("metadata", МетаданныеВСтроку(СтрокаЖурнала.Метаданные));
		Запись.Вставить("data_presentation", Строка(СтрокаЖурнала.ПредставлениеДанных));
		Запись.Вставить("session", СтрокаЖурнала.Сеанс);
		Запись.Вставить("application", ПриложениеВСтроку(СтрокаЖурнала.ИмяПриложения));
		Запись.Вставить("computer", Строка(СтрокаЖурнала.Компьютер));
		Запись.Вставить("transaction_status", СтатусТранзакцииВСтроку(СтрокаЖурнала.СтатусТранзакции));
		Записи.Добавить(Запись);
		
		ПоследняяДата = СтрокаЖурнала.Дата;
		
	КонецЦикла;
	
	Если Не ЕстьЕще И ТаблицаЖурнала.Количество() >= МаксимумВыгрузки Тогда
		ЕстьЕще = Истина;
	КонецЕсли;
	
	СледующееСмещение = РассчитатьСмещениеПагинации(
		Записи, ПоследняяДата, ДатаНачала, СмещениеСекунды);
	
	Результат = Новый Структура;
	Результат.Вставить("Записи", Записи);
	Результат.Вставить("ЕстьЕще", ЕстьЕще);
	Результат.Вставить("ПоследняяДата", ПоследняяДата);
	Результат.Вставить("СледующееСмещение", СледующееСмещение);
	
	Возврат Результат;
	
КонецФункции

// Считает next_same_second_offset для курсорной пагинации.
//
// Параметры:
//  Записи - Массив из Структура - отобранные записи с полем date
//  ПоследняяДата - Дата, Неопределено - дата последней записи
//  ДатаНачала - Дата, Неопределено - начало периода фильтра
//  СмещениеСекунды - Число - текущий same_second_offset
//
// Возвращаемое значение:
//  Число - следующее смещение внутри секунды
//
Функция РассчитатьСмещениеПагинации(Записи, ПоследняяДата, ДатаНачала, СмещениеСекунды)
	
	СледующееСмещение = 0;
	
	Если ПоследняяДата <> Неопределено Тогда
		
		Если ДатаНачала <> Неопределено
			И ДатаБезМиллисекунд(ПоследняяДата) = ДатаБезМиллисекунд(ДатаНачала) Тогда
			СледующееСмещение = СмещениеСекунды;
		КонецЕсли;
		
		Для Каждого Запись Из Записи Цикл
			Если ДатаБезМиллисекунд(Запись.date) = ДатаБезМиллисекунд(ПоследняяДата) Тогда
				СледующееСмещение = СледующееСмещение + 1;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СледующееСмещение;
	
КонецФункции

// Возвращает значение свойства структуры аргументов или Неопределено.
//
// Параметры:
//  Аргументы - Структура
//  Имя - Строка
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеАргумента(Аргументы, Имя)
	
	Значение = Неопределено;
	Аргументы.Свойство(Имя, Значение);
	
	Возврат Значение;
	
КонецФункции

// В платформе нет НачалоСекунды; обнуляем миллисекунды для сравнения курсора пагинации.
//
// Параметры:
//  ЗначениеДаты - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаБезМиллисекунд(ЗначениеДаты)
	
	Возврат Дата(
		Год(ЗначениеДаты),
		Месяц(ЗначениеДаты),
		День(ЗначениеДаты),
		Час(ЗначениеДаты),
		Минута(ЗначениеДаты),
		Секунда(ЗначениеДаты));
	
КонецФункции

// Разбирает дату из строки ISO 8601.
//
// Параметры:
//  СтрокаДаты - Строка
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаИзISO(СтрокаДаты)
	
	Стр = СокрЛП(Строка(СтрокаДаты));
	Стр = СтрЗаменить(Стр, "T", " ");
	Стр = СтрЗаменить(Стр, "t", " ");
	Если СтрНайти(Стр, ".") > 0 Тогда
		Стр = Лев(Стр, СтрНайти(Стр, ".") - 1);
	КонецЕсли;
	Если СтрНайти(Стр, "+") > 11 Тогда
		Стр = Лев(Стр, СтрНайти(Стр, "+") - 1);
	КонецЕсли;
	Стр = СтрЗаменить(Стр, "-", "");
	Стр = СтрЗаменить(Стр, ":", "");
	Стр = СтрЗаменить(Стр, " ", "");
	
	Если СтрДлина(Стр) < 8 Тогда
		ВызватьИсключение "Некорректный формат даты: " + СтрокаДаты;
	КонецЕсли;
	
	ГодЧисло = Число(Лев(Стр, 4));
	МесяцЧисло = Число(Сред(Стр, 5, 2));
	ДеньЧисло = Число(Сред(Стр, 7, 2));
	ЧасЧисло = 0;
	МинЧисло = 0;
	СекЧисло = 0;
	Если СтрДлина(Стр) >= 10 Тогда
		ЧасЧисло = Число(Сред(Стр, 9, 2));
	КонецЕсли;
	Если СтрДлина(Стр) >= 12 Тогда
		МинЧисло = Число(Сред(Стр, 11, 2));
	КонецЕсли;
	Если СтрДлина(Стр) >= 14 Тогда
		СекЧисло = Число(Сред(Стр, 13, 2));
	КонецЕсли;
	
	Возврат Дата(ГодЧисло, МесяцЧисло, ДеньЧисло, ЧасЧисло, МинЧисло, СекЧисло);
	
КонецФункции

// Нормализует значение аргумента в массив строк.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Массив, Неопределено -
//
Функция НормализоватьМассивСтрок(Значение)
	
	Результат = Неопределено;
	
	Если Значение <> Неопределено И Значение <> "" Тогда
		
		Результат = Новый Массив;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого Элемент Из Значение Цикл
				Если ЗначениеЗаполнено(Элемент) Тогда
					Результат.Добавить(Строка(Элемент));
				КонецЕсли;
			КонецЦикла;
		Иначе
			Результат.Добавить(Строка(Значение));
		КонецЕсли;
		
		Если Результат.Количество() = 0 Тогда
			Результат = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Нормализует значение аргумента в массив чисел.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Массив, Неопределено
//
Функция НормализоватьМассивЧисел(Значение)
	
	Результат = Неопределено;
	
	Если Значение <> Неопределено И Значение <> "" Тогда
		
		Результат = Новый Массив;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого Элемент Из Значение Цикл
				Результат.Добавить(Число(Элемент));
			КонецЦикла;
		Иначе
			Результат.Добавить(Число(Значение));
		КонецЕсли;
		
		Если Результат.Количество() = 0 Тогда
			Результат = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует имена уровней журнала в значения перечисления платформы.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Массив, Неопределено
//
Функция ПреобразоватьУровни(Значение)
	
	Результат = Неопределено;
	Строки = НормализоватьМассивСтрок(Значение);
	
	Если Строки <> Неопределено Тогда
		
		Результат = Новый Массив;
		Для Каждого ИмяУровня Из Строки Цикл
			Ключ = ВРег(СокрЛП(ИмяУровня));
			Если Ключ = "INFORMATION" Или Ключ = "ИНФОРМАЦИЯ" Тогда
				Результат.Добавить(УровеньЖурналаРегистрации.Информация);
			ИначеЕсли Ключ = "WARNING" Или Ключ = "ПРЕДУПРЕЖДЕНИЕ" Тогда
				Результат.Добавить(УровеньЖурналаРегистрации.Предупреждение);
			ИначеЕсли Ключ = "ERROR" Или Ключ = "ОШИБКА" Тогда
				Результат.Добавить(УровеньЖурналаРегистрации.Ошибка);
			ИначеЕсли Ключ = "NOTE" Или Ключ = "ПРИМЕЧАНИЕ" Тогда
				Результат.Добавить(УровеньЖурналаРегистрации.Примечание);
			Иначе
				ВызватьИсключение "Неизвестный уровень журнала: " + ИмяУровня;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует полные имена метаданных в объекты метаданных.
