#Область ОбщийИнтерфейс

Функция rpcPOST(Запрос)
	// Обрабатываем через унифицированную функцию
	Возврат ОбработатьJSONRPCЗапрос(Запрос);
КонецФункции

Функция healthGET(Запрос)
	ОтветДанные = Новый Структура;
	ОтветДанные.Вставить("status", "ok");

	JSONСтрока = mcp_ОбщегоНазначения.СтруктураВJSON(ОтветДанные);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(JSONСтрока, КодировкаТекста.UTF8);

	Возврат Ответ;
КонецФункции

Функция mcpPOST(Запрос)
	// Обрабатываем MCP Streamable HTTP запросы через унифицированную функцию
	Возврат ОбработатьJSONRPCЗапрос(Запрос);
КонецФункции

Функция mcpGET(Запрос)
	// GET не поддерживается для MCP эндпоинта согласно спецификации
	Ответ = Новый HTTPСервисОтвет(405);
	Ответ.Заголовки.Вставить("Allow", "POST");
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область УнифицированнаяОбработкаJSONRPC

Функция ОбработатьJSONRPCЗапрос(Запрос)
	// Тонкая HTTP-обёртка над транспортно-независимым ядром mcp_Диспетчер.
	// Вся маршрутизация и формирование JSON-RPC ответа — в mcp_Диспетчер.ОбработатьСтроку.
	// Здесь остаётся только HTTP-специфика: тело запроса/ответа, коды состояния, заголовки.

	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ТелоОтвета  = mcp_Диспетчер.ОбработатьСтроку(ТелоЗапроса, КонтекстЗапроса(Запрос));

	// notifications (запрос без id) → диспетчер вернул пустую строку → 204 No Content
	Если НЕ ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат СформироватьОтвет204();
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	// CORS заголовки для совместимости с браузерными клиентами
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);

	Возврат Ответ;
КонецФункции

// Контекст запроса из заголовков клиента MCP: инструменты получают его в аргументе _context,
// см. mcp_Диспетчер.ОбработатьСтроку. Заголовки ищутся без учета регистра: прокси может передать их строчными.
//
// X-1C-Open-Link-Base - адрес страницы, открывающей навигационные ссылки в 1С щелчком
// (перенаправление на e1c://...), свойство openLinkBase.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  Структура - пустая, если заголовков контекста нет
//
Функция КонтекстЗапроса(Запрос)

	Контекст = Новый Структура;

	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "x-1c-open-link-base" И ЗначениеЗаполнено(Заголовок.Значение) Тогда
			Контекст.Вставить("openLinkBase", СокрЛП(Заголовок.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Контекст;

КонецФункции

Функция СформироватьОтвет204()
	// Формирует ответ 204 No Content для notifications

	Ответ = Новый HTTPСервисОтвет(204);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");

	Возврат Ответ;
КонецФункции

#КонецОбласти
