// Обмен с клиентским агентом MCP (расширение Ei): подтверждение кода человеком и выполнение кода на клиенте.
// Протокол описан в docs/client-agent-protocol.md, ключи и форматы менять только вместе с агентом.

#Область ПрограммныйИнтерфейс

// Проверяет, можно ли обратиться к клиентскому агенту.
//
// Возвращаемое значение:
//  Структура:
//   * Доступен - Булево
//   * Причина - Строка - почему агент недоступен
//
Функция СостояниеАгента() Экспорт
	
	Состояние = Новый Структура("Доступен, Причина", Ложь, "");
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуляАгента()) = Неопределено Тогда
		Состояние.Причина = "клиентский агент (расширение Ei) не установлен в базу";
	ИначеЕсли Не УведомленияКлиентаПоддерживаются() Тогда
		Состояние.Причина = "уведомления клиента требуют платформу " + МинимальнаяВерсияПлатформы() + " или новее";
	Иначе
		Состояние.Доступен = Истина;
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

// Отправляет запрос клиентскому агенту (или продолжает ожидание по ранее созданному) и ждет ответ.
//
// Параметры:
//  Код - Строка - код как его прислала модель
//  Контекст - Строка - server или client
//  ОпасныеКонструкции - Массив из Строка - найденные конструкции, для подсветки у человека
//  ИдентификаторЗапроса - Строка - request_id прежнего вызова, пустой - создать новый запрос
//
// Возвращаемое значение:
//  Структура:
//   * Статус - Строка - answered, pending или error
//   * Идентификатор - Строка - идентификатор запроса
//   * Ответ - Структура, Неопределено - проверенный ответ агента для answered
//   * Ошибка - Строка - текст ошибки для error
//
Функция ЗапроситьРешение(Код, Контекст, ОпасныеКонструкции, ИдентификаторЗапроса) Экспорт
	
	Итог = Новый Структура;
	Итог.Вставить("Статус", "error");
	Итог.Вставить("Идентификатор", "");
	Итог.Вставить("Ответ", Неопределено);
	Итог.Вставить("Ошибка", "");
	
	Хеш = ХешКода(Код);
	
	Если ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Запрос = ЗагрузитьЗапрос(ИдентификаторЗапроса);
		Если Запрос = Неопределено Тогда
			Итог.Ошибка = "Запрос request_id=" + ИдентификаторЗапроса
				+ " не найден или уже закрыт. Вызовите execute_code без request_id, чтобы создать новый запрос.";
		ИначеЕсли Запрос.Хеш <> Хеш Или Запрос.Контекст <> Контекст Тогда
			Итог.Ошибка = "Код или execution_context отличаются от запроса request_id=" + ИдентификаторЗапроса
				+ ". Передайте тот же код без изменений или вызовите execute_code без request_id.";
		КонецЕсли;
	Иначе
		Запрос = НовыйЗапрос(Код, Хеш, Контекст, ОпасныеКонструкции, Итог);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
		
		Итог.Идентификатор = Запрос.Идентификатор;
		Если ТекущаяУниверсальнаяДата() <= Запрос.СрокДействия Тогда
			ДождатьсяОтвета(Запрос);
		КонецЕсли;
		
		Ответ = ЗабратьОтвет(Запрос.Идентификатор);
		Если Ответ <> Неопределено Тогда
			ОшибкаПроверки = ОшибкаПроверкиОтвета(Ответ, Запрос);
			Если ЗначениеЗаполнено(ОшибкаПроверки) Тогда
				ЗакрытьЗапрос(Запрос, "Ответ не прошел проверку");
				Итог.Ошибка = ОшибкаПроверки;
			Иначе
				ЗакрытьЗапрос(Запрос, "Ответ получен");
				Итог.Статус = "answered";
				Итог.Ответ = Ответ;
			КонецЕсли;
		ИначеЕсли ТекущаяУниверсальнаяДата() > Запрос.СрокДействия Тогда
			ЗакрытьЗапрос(Запрос, "Истек срок действия");
			Итог.Ошибка = "Срок действия запроса request_id=" + Запрос.Идентификатор
				+ " истек: пользователь не ответил. Вызовите execute_code без request_id, чтобы создать новый запрос.";
		Иначе
			Итог.Статус = "pending";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Ждет в фоновом задании, пока агент не запишет ответ или не наступит срок.
// Вызывается только из ДождатьсяОтвета.
//
// Параметры:
//  Идентификатор - Строка - идентификатор запроса
//  Срок - Дата - универсальное время окончания ожидания
//
Процедура ОжидатьОтветВФоне(Идентификатор, Срок) Экспорт
	
	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пока Не ОтветЕсть(Идентификатор) И ТекущаяУниверсальнаяДата() < Срок Цикл
		// Ожидание завершения самого себя - пауза без нагрузки на процессор.
		ТекущееЗадание.ОжидатьЗавершенияВыполнения(ИнтервалОпросаОтвета());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Запросы

Функция НовыйЗапрос(Код, Хеш, Контекст, ОпасныеКонструкции, Итог)
	
	Запрос = Неопределено;
	УдалитьУстаревшиеЗапросы();
	
	НомераСеансов = КлиентскиеСеансыПользователя(Контекст = "client");
	Если НомераСеансов.Количество() = 0 Тогда
		Итог.Ошибка = "Нет открытых клиентских сеансов пользователя " + ИмяПользователя()
			+ ": запрос некому показать. Запустите клиент 1С (тонкий, толстый или веб) под этим пользователем.";
	Иначе
		
		Создан = ТекущаяУниверсальнаяДата();
		
		Запрос = Новый Структура;
		Запрос.Вставить("ВерсияПротокола", ВерсияПротокола());
		Запрос.Вставить("Идентификатор", Строка(Новый УникальныйИдентификатор));
		Запрос.Вставить("Пользователь", ИмяПользователя());
		Запрос.Вставить("Контекст", Контекст);
		Запрос.Вставить("Хеш", Хеш);
		Запрос.Вставить("ОпасныеКонструкции", ОпасныеКонструкции);
		Запрос.Вставить("ТребуетсяПодтверждение", Контекст = "server" Или ОпасныеКонструкции.Количество() > 0);
		Запрос.Вставить("Создан", Создан);
		Запрос.Вставить("СрокДействия", Создан + СрокДействияЗапроса());
		Запрос.Вставить("НомераСеансов", НомераСеансов);
		
		ДанныеУведомления = Новый Структура;
		Для Каждого КлючИЗначение Из Запрос Цикл
			ДанныеУведомления.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		ДанныеУведомления.Удалить("НомераСеансов");
		ДанныеУведомления.Вставить("Код", Код);
		
		ХранилищеОбщихНастроек.Сохранить(КлючЗапросов(), Запрос.Идентификатор, Запрос);
		Попытка
			ОтправитьУведомлениеКлиенту(КлючУведомленияЗапрос(), ДанныеУведомления, НомераСеансов);
		Исключение
			ХранилищеОбщихНастроек.Удалить(КлючЗапросов(), Запрос.Идентификатор, ИмяПользователя());
			Итог.Ошибка = "Не удалось отправить уведомление клиентскому агенту: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
				+ ". Если платформа не дает обратиться к УведомленияКлиента, поднимите режим совместимости расширения MCP до 8.3.27.";
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция ЗагрузитьЗапрос(Идентификатор)
	
	Запрос = ХранилищеОбщихНастроек.Загрузить(КлючЗапросов(), Идентификатор);
	Если ТипЗнч(Запрос) <> Тип("Структура") Тогда
		Запрос = Неопределено;
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Процедура ЗакрытьЗапрос(Запрос, Причина)
	
	ХранилищеОбщихНастроек.Удалить(КлючЗапросов(), Запрос.Идентификатор, ИмяПользователя());
	
	ДанныеУведомления = Новый Структура("Идентификатор, Причина", Запрос.Идентификатор, Причина);
	Попытка
		ОтправитьУведомлениеКлиенту(КлючУведомленияЗакрыт(), ДанныеУведомления, Запрос.НомераСеансов);
	Исключение
		// Окно запроса останется открытым, но ответ из него уже не будет принят.
		ЗаписьЖурналаРегистрации("MCP.ЗапросВыполненияКода", УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Удаляет запросы с истекшим сроком и ответы на них, если модель так и не вернулась за ответом.
Процедура УдалитьУстаревшиеЗапросы()
	
	ТекущаяДата = ТекущаяУниверсальнаяДата();
	
	Для Каждого ЭлементСписка Из ХранилищеОбщихНастроек.ПолучитьСписок(КлючЗапросов()) Цикл
		Идентификатор = ЭлементСписка.Значение;
		Запрос = ЗагрузитьЗапрос(Идентификатор);
		Если Запрос = Неопределено Или ТекущаяДата > Запрос.СрокДействия Тогда
			ХранилищеОбщихНастроек.Удалить(КлючЗапросов(), Идентификатор, ИмяПользователя());
			ХранилищеОбщихНастроек.Удалить(КлючОтветов(), Идентификатор, ИмяПользователя());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Ответы

Процедура ДождатьсяОтвета(Запрос)
	
	Если ОтветЕсть(Запрос.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	Срок = Мин(ТекущаяУниверсальнаяДата() + ВремяОжиданияОтвета(), Запрос.СрокДействия);
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Запрос.Идентификатор);
	ПараметрыЗадания.Добавить(Срок);
	
	Попытка
		Задание = ФоновыеЗадания.Выполнить("mcp_КлиентскийАгент.ОжидатьОтветВФоне", ПараметрыЗадания, ,
			"MCP: ожидание ответа клиентского агента");
		Задание = Задание.ОжидатьЗавершенияВыполнения(ВремяОжиданияОтвета() + 5);
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Задание.Отменить();
		КонецЕсли;
	Исключение
		// Без фонового задания ответ проверяется один раз, модель повторит вызов с request_id.
		ЗаписьЖурналаРегистрации("MCP.ЗапросВыполненияКода", УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ОтветЕсть(Идентификатор)
	
	Возврат ХранилищеОбщихНастроек.Загрузить(КлючОтветов(), Идентификатор) <> Неопределено;
	
КонецФункции

// Читает ответ и сразу удаляет его из хранилища: ответ одноразовый.
Функция ЗабратьОтвет(Идентификатор)
	
	Ответ = ХранилищеОбщихНастроек.Загрузить(КлючОтветов(), Идентификатор);
	Если Ответ <> Неопределено Тогда
		ХранилищеОбщихНастроек.Удалить(КлючОтветов(), Идентификатор, ИмяПользователя());
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ОшибкаПроверкиОтвета(Ответ, Запрос)
	
	ОшибкаПроверки = "";
	
	Если ТипЗнч(Ответ) <> Тип("Структура")
		Или Не ЕстьСвойства(Ответ, "ВерсияПротокола, Идентификатор, Хеш, Создан, Контекст, Решение, НомерСеанса, Ответил") Тогда
		ОшибкаПроверки = "Ответ клиентского агента имеет неверный формат";
	ИначеЕсли Ответ.Идентификатор <> Запрос.Идентификатор
		Или Ответ.Хеш <> Запрос.Хеш
		Или Ответ.Создан <> Запрос.Создан
		Или Ответ.Контекст <> Запрос.Контекст Тогда
		ОшибкаПроверки = "Ответ клиентского агента не соответствует запросу";
	ИначеЕсли ТипЗнч(Ответ.Ответил) <> Тип("Дата") Или Ответ.Ответил > Запрос.СрокДействия Тогда
		ОшибкаПроверки = "Ответ клиентского агента получен после срока действия запроса";
	ИначеЕсли ДопустимыеРешения(Запрос.Контекст).Найти(Ответ.Решение) = Неопределено Тогда
		ОшибкаПроверки = "Недопустимое решение клиентского агента: " + Строка(Ответ.Решение);
	ИначеЕсли Ответ.Решение = "Выполнено"
		И Не ЕстьСвойства(Ответ, "Успех, РезультатJSON, ТипРезультата, Ошибка, Код, КодИзменен") Тогда
		ОшибкаПроверки = "Ответ клиентского агента о выполнении кода имеет неверный формат";
	ИначеЕсли Не СеансОтветаДопустим(Ответ.НомерСеанса) Тогда
		ОшибкаПроверки = "Ответ записан не из интерактивного клиентского сеанса пользователя " + ИмяПользователя()
			+ " и не принят";
	КонецЕсли;
	
	Возврат ОшибкаПроверки;
	
КонецФункции

Функция ДопустимыеРешения(Контекст)
	
	Решения = Новый Массив; // Массив из Строка
	Решения.Добавить("Отклонено");
	Если Контекст = "server" Тогда
		Решения.Добавить("Разрешено");
	Иначе
		Решения.Добавить("Выполнено");
	КонецЕсли;
	
	Возврат Решения;
	
КонецФункции

Функция ЕстьСвойства(Структура, ИменаСвойств)
	
	Есть = Истина;
	Для Каждого ИмяСвойства Из СтрРазделить(ИменаСвойств, ",", Ложь) Цикл
		Если Не Структура.Свойство(СокрЛП(ИмяСвойства)) Тогда
			Есть = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Есть;
	
КонецФункции

#КонецОбласти

#Область Сеансы

// Возвращает номера интерактивных клиентских сеансов текущего пользователя.
//
// Параметры:
//  ТолькоПоследний - Булево - вернуть только последний начатый сеанс
//
// Возвращаемое значение:
//  Массив из Число
//
Функция КлиентскиеСеансыПользователя(ТолькоПоследний)
	
	НомераСеансов = Новый Массив; // Массив из Число
	ПоследнийСеанс = Неопределено;
	ИмяТекущегоПользователя = ИмяПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	Сеансы = ПолучитьСеансыИнформационнойБазы();
	
	Для Каждого Сеанс Из Сеансы Цикл
		Если Не ЭтоКлиентскийСеансПользователя(Сеанс, ИмяТекущегоПользователя) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ТолькоПоследний Тогда
			НомераСеансов.Добавить(Сеанс.НомерСеанса);
		ИначеЕсли ПоследнийСеанс = Неопределено Или Сеанс.НачалоСеанса > ПоследнийСеанс.НачалоСеанса Тогда
			ПоследнийСеанс = Сеанс;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ПоследнийСеанс <> Неопределено Тогда
		НомераСеансов.Добавить(ПоследнийСеанс.НомерСеанса);
	КонецЕсли;
	
	Возврат НомераСеансов;
	
КонецФункции

// Проверяет, что сеанс, записавший ответ, существует, принадлежит текущему пользователю
// и является интерактивным клиентом: ответ из HTTP-сеанса или фонового задания не принимается.
Функция СеансОтветаДопустим(НомерСеанса)
	
	Допустим = Ложь;
	ИмяТекущегоПользователя = ИмяПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	Сеансы = ПолучитьСеансыИнформационнойБазы();
	
	Для Каждого Сеанс Из Сеансы Цикл
		Если Сеанс.НомерСеанса = НомерСеанса Тогда
			Допустим = ЭтоКлиентскийСеансПользователя(Сеанс, ИмяТекущегоПользователя);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Допустим;
	
КонецФункции

Функция ЭтоКлиентскийСеансПользователя(Сеанс, ИмяПользователяСеанса)
	
	ИмяПользователяСеансаФакт = "";
	Если Сеанс.Пользователь <> Неопределено Тогда
		ИмяПользователяСеансаФакт = Сеанс.Пользователь.Имя;
	КонецЕсли;
	
	Возврат ИмяПользователяСеансаФакт = ИмяПользователяСеанса
		И КлиентскиеПриложения().Найти(Сеанс.ИмяПриложения) <> Неопределено;
	
КонецФункции

Функция КлиентскиеПриложения()
	
	Приложения = Новый Массив; // Массив из Строка
	Приложения.Добавить("1CV8C");
	Приложения.Добавить("1CV8");
	Приложения.Добавить("WebClient");
	
	Возврат Приложения;
	
КонецФункции

#КонецОбласти

#Область УведомленияКлиента

Процедура ОтправитьУведомлениеКлиенту(Ключ, Данные, НомераСеансов)
	
	МенеджерУведомленийКлиента().ОтправитьУведомление(Ключ, Данные, НомераСеансов);
	
КонецПроцедуры

Функция МенеджерУведомленийКлиента()
	
	УстановитьБезопасныйРежим(Истина);
	
	// Свойство глобального контекста появилось в 8.3.27 и неизвестно EDT - обращаемся по имени, как БСП.
	//@skip-check server-execution-safe-mode
	Возврат Вычислить("УведомленияКлиента");
	
КонецФункции

Функция УведомленияКлиентаПоддерживаются()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, МинимальнаяВерсияПлатформы()) >= 0;
	
КонецФункции

// Сравнивает версии вида 8.3.27.1606.
//
// Возвращаемое значение:
//  Число - больше нуля, если Версия1 новее, меньше нуля, если старее, ноль - если равны
//
Функция СравнитьВерсии(Версия1, Версия2)
	
	Результат = 0;
	Части1 = СтрРазделить(Версия1, ".");
	Части2 = СтрРазделить(Версия2, ".");
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	
	Для Индекс = 0 По Макс(Части1.ВГраница(), Части2.ВГраница()) Цикл
		Число1 = 0;
		Если Индекс <= Части1.ВГраница() Тогда
			Число1 = ОписаниеЧисла.ПривестиЗначение(Части1[Индекс]);
		КонецЕсли;
		Число2 = 0;
		Если Индекс <= Части2.ВГраница() Тогда
			Число2 = ОписаниеЧисла.ПривестиЗначение(Части2[Индекс]);
		КонецЕсли;
		Если Число1 <> Число2 Тогда
			Результат = Число1 - Число2;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Константы

Функция ХешКода(Код)
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Код, КодировкаТекста.UTF8, Ложь));
	
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	
КонецФункции

